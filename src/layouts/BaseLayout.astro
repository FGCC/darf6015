---
const { 
  title = "DARF 6015 | Cálculo e Guia para Investidores", 
  description // Deixamos sem valor fixo aqui para ser obrigatório ou opcional
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
import '../styles/fonts.css';
---
<!DOCTYPE html>
<html lang="pt-BR" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

<meta name="description" content={description} />

<link rel="canonical" href={canonicalURL} />

<!-- Favicon -->
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preload" href="/fonts/roboto-v50-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/roboto-v50-latin-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/roboto-v50-latin-700.woff2" as="font" type="font/woff2" crossorigin />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.darf6015.com.br/#organization",
      "name": "DARF 6015",
      "url": "https://www.darf6015.com.br/",
      "sameAs": [
        "https://www.twitter.com/TraderBolsa",
        "https://www.instagram.com/traderbolsa",
        "https://www.facebook.com/investimentonabolsa",
        "https://www.linkedin.com/company/trading-bolsa/",
        "https://br.pinterest.com/traderbolsa/",
        "https://www.threads.com/@traderbolsa"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.darf6015.com.br/#website",
      "url": "https://www.darf6015.com.br/",
      "name": "DARF 6015 | Cálculo e Guia para Investidores",
      "publisher": { "@id": "https://www.darf6015.com.br/#organization" }
    }
  ]
}
</script>

  </head>
  <body>
    <header>
  <nav aria-label="Navegação Principal">
    <a 
      href="/" 
      rel="home" 
      title="Calculadora de DARF 6015 e Guia de Imposto de Renda de Ações"
    >
      DARF 6015 | Calculadora IR Bolsa
    </a>

    <a 
      href="/cotacoes-bolsas-mundiais-em-tempo-real/" 
      title="Cotações Bolsas Mundiais em Tempo Real"
    >
      Bolsas Mundiais em Tempo Real
    </a>
  </nav>
</header>

<div class="container-central">
    <main>
      <slot />
    </main>
</div>

    <footer>
  <div class="footer-social">
    <a href="https://www.twitter.com/TraderBolsa" target="_blank" rel="me noopener noreferrer">Twitter</a>
    <a href="https://www.instagram.com/traderbolsa" target="_blank" rel="me noopener noreferrer">Instagram</a>
    <a href="https://www.facebook.com/investimentonabolsa" target="_blank" rel="me noopener noreferrer">Facebook</a>
    <a href="https://www.linkedin.com/company/trading-bolsa/" target="_blank" rel="me noopener noreferrer">LinkedIn</a>
  </div>

  <div class="footer-nav">
    <a href="/sobre-nos/">Sobre nós</a>
    <span class="sep">|</span>
    <a href="/politica-de-privacidade/">Privacidade</a>
  </div>

  <div class="footer-copy">
    Copyright &copy; 2026 <strong>DARF 6015</strong>
  </div>
</footer>
  </body>
</html>
