---
const { title = "DARF 6015" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="pt-BR" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

<link rel="canonical" href={canonicalURL} />

<!-- Favicon -->
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preload" href="/fonts/roboto-v50-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/roboto-v50-latin-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/roboto-v50-latin-700.woff2" as="font" type="font/woff2" crossorigin />

  <style is:global>
    @import "/src/styles/fonts.css";

    body {
      font-family: 'Roboto', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }
  </style>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.darf6015.com.br/#organization",
      "name": "DARF 6015",
      "url": "https://www.darf6015.com.br/",
      "sameAs": [
        "https://www.twitter.com/TraderBolsa",
        "https://www.instagram.com/traderbolsa",
        "https://www.facebook.com/investimentonabolsa",
        "https://www.linkedin.com/company/trading-bolsa/",
        "https://br.pinterest.com/traderbolsa/",
        "https://www.threads.com/@traderbolsa"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.darf6015.com.br/#website",
      "url": "https://www.darf6015.com.br/",
      "name": "DARF 6015",
      "publisher": { "@id": "https://www.darf6015.com.br/#organization" }
    }
  ]
}
</script>

    <style>
      body {
        margin: 0;
        font-family: Roboto, sans-serif;
        font-size: 16px;
        background: #f2f2f2;
        color: #111;
      }
      header {
        background: #000;
        padding: 16px;
      }
      nav {
        max-width: 1100px;
        margin: auto;
        display: flex;
        gap: 24px;
      }
      nav a {
        color: #fff;
        text-decoration: none;
        font-weight: 500;
      }
      main {
        max-width: 1100px;
        margin: 32px auto;
        padding: 0 14px;
      }
      footer {
        border-top: 1px solid #ddd;
        padding: 24px;
        text-align: center;
      }
      footer a {
        margin: 0 14px;
        color: #000;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">DARF 6015</a>
        <a href="/cotacoes-bolsas-mundiais-em-tempo-real/">Cotações Bolsas Mundiais em Tempo Real</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
  <div style="margin-bottom: 10px; text-align: center;">
	<a href="https://www.twitter.com/TraderBolsa" target="_blank" rel="me noopener noreferrer">Twitter</a>
	<a href="https://www.instagram.com/traderbolsa" target="_blank" rel="me noopener noreferrer">Instagram</a>
	<a href="https://www.facebook.com/investimentonabolsa" target="_blank" rel="me noopener noreferrer">Facebook</a>
	<a href="https://www.linkedin.com/company/trading-bolsa/" target="_blank" rel="me noopener noreferrer">LinkedIn</a>
  </div>

  <div style="margin-bottom: 10px; text-align: center;">
    <a href="/sobre-nos/">Sobre nós</a>
  </div>

  <div style="font-size: 14px; font-weight: bold; text-align: center;">
    Copyright © 2026 DARF 6015
  </div>
</footer>
  </body>
</html>
