---
const { title = "DARF 6015" } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

    <style>
      body {
        margin: 0;
        font-family: Roboto, sans-serif;
        font-size: 12px;
        background: #f2f2f2;
        color: #111;
      }
      header {
        background: #000;
        padding: 14px;
      }
      nav {
        max-width: 1100px;
        margin: auto;
        display: flex;
        gap: 24px;
      }
      nav a {
        color: #fff;
        text-decoration: none;
        font-weight: 500;
      }
      main {
        max-width: 1100px;
        margin: 32px auto;
        padding: 0 16px;
      }
      footer {
        border-top: 1px solid #ddd;
        padding: 24px;
        text-align: center;
      }
      footer a {
        margin: 0 10px;
        color: #000;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">DARF 6015</a>
        <a href="/cotacoes-mundiais">Cotações Mundiais</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <a href="#">Twitter</a>
      <a href="#">Instagram</a>
      <a href="#">Facebook</a>
      <a href="#">LinkedIn</a>
    </footer>
  </body>
</html>
