      "@id": "https://www.darf6015.com.br/#organization",
      "name": "DARF 6015",
      "url": "https://www.darf6015.com.br/",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "BR"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "contato@darf6015.com.br",
        "contactType": "customer support",
        "areaServed": "BR"
      },
      "sameAs": [
        "https://www.twitter.com/darf6015",
        "https://www.instagram.com/darf6015",
        "https://www.facebook.com/darf6015",
        "https://www.linkedin.com/company/darf6015/",
        "https://br.pinterest.com/darf6015/",
        "https://www.threads.com/@darf6015"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.darf6015.com.br/#website",
      "url": "https://www.darf6015.com.br/",
      "name": "Gerar DARF 6015: Planilha IR Day Trade e Swing Trade",
      "description": "Calcule seu IR sobre ações de forma automática. Planilha para controle de operações de Day Trade e Swing Trade com foco no código DARF 6015.",
      "publisher": { "@id": "https://www.darf6015.com.br/#organization" },
      "inLanguage": "pt-BR"
    },
    {
      "@type": "AboutPage",
      "@id": "https://www.darf6015.com.br/sobre-nos/#webpage",
      "url": "https://www.darf6015.com.br/sobre-nos/",
      "name": "Sobre Nós - DARF 6015",
      "description": "Conheça a história da DARF 6015 e nossa missão de simplificar o cálculo de impostos para investidores de Day Trade e Swing Trade.",
