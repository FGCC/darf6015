---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "404 - Página não encontrada";
const description = "A página que você está procurando não existe. Volte para o início do site DARF 6015.";
const siteURL = "https://www.darf6015.com.br";
const canonicalURL = `${siteURL}${Astro.url.pathname}`;
---
<BaseLayout title={title} description={description} canonical={canonicalURL} robots="noindex, follow">
  <main style="text-align: center; padding: 80px 20px;">
    <h1 style="font-size: 48px; margin-bottom: 20px;">404</h1>
    <p style="font-size: 18px; margin-bottom: 30px;">Página não encontrada.</p>
    <a href="/" style="color:#0070f3; font-weight:500; text-decoration:none;">Voltar para o início</a>
  </main>
</BaseLayout>
